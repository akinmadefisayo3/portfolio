        "text": "=Email Subject:{{ $json.Subject }}\nEmail Body:{{ $json.body }}\n\n{\n  \"category\": \"string\",\n  \"summary\": \"string\"\n}\n",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You analyze emails and categorize them into one of the following departments:\n\n- Sales\n- Finance\n- HR\n- Customer Service\n- Operations\n- AI and Automation\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"category\": \"AI and Automation\",\n  \"summary\": \"Short professional summary of the email (2–3 sentences)\"\n}\n\nRules:\n- Do NOT include explanations\n- Do NOT include extra text\n- Do NOT use markdown\n- Output must be valid JSON\n"
        }
      },
