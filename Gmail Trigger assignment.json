    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n\n  // Get email body safely (textPlain first, fallback to textHtml)\n  const emailBody = (item.json.textPlain || item.json.textHtml || \"\").toString();\n  const emailText = emailBody.toLowerCase();\n\n  let category = \"OTHER\";\n\n  if (emailText.includes(\"sale\") || emailText.includes(\"revenue\")) {\n    category = \"SALES\";\n  } \n  else if (emailText.includes(\"hr\") || emailText.includes(\"payroll\")) {\n    category = \"HR\";\n  } \n  else if (emailText.includes(\"ai and automation\") || emailText.includes(\"campaign\")) {\n    category = \"AI AND AUTOMATION\";\n  } \n  else if (emailText.includes(\"customer\") || emailText.includes(\"support\")) {\n    category = \"CUSTOMER SERVICE\";\n  }\n\n  return {\n    json: {\n      ...item.json,     // keep EVERYTHING from the original email\n      body: emailBody,  // explicitly keep body\n      category: category\n    },\n    pairedItem: index\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
